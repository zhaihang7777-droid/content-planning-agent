# Export locally; this file is not automatically loaded. Never commit real keys.
OPENAI_API_KEY=replace-locally
# Set the exact API model ID available to your OpenAI project.
OPENAI_MODEL=replace-with-your-codex-model-id
# Optional for --provider codex; uses codex login, no API key needed.
# CODEX_MODEL=your-account-model-id
# Optional Gemini gateway configuration:
GEMINI_BASE_URL=https://ai.novacode.top/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=replace-locally
# DeepSeek official API:
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=replace-locally
